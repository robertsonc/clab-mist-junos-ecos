# Copy to .env and fill in. .env is gitignored - never commit real values.

# Mist (used by scripts/mist_site_create.py and scripts/mist_rename.py).
# This org is on the AC2 cloud, so the API base is api.ac2.mist.com.
export MIST_ORG_ID="<org uuid>"
export MIST_API_KEY="<api token>"

# Aruba Orchestrator (used by scripts/orch_api.py for EC-V work).
export ORCH_URL="<orchestrator hostname>"
export ORCH_API_KEY="<api key>"

# EC-V registration, consumed via env-file by the topologies.
# Docker env-file format: values are taken LITERALLY, do not quote them.
ECOS_ADMIN_PASSWORD=<password>
ECOS_REGISTRATION_KEY=<registration key>
ECOS_ACCOUNT_NAME=<account name>
ECOS_PORTAL_HOSTNAME=
